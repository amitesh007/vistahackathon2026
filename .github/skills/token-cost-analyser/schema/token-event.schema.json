{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin-lending/schemas/token-cost-analyser/token-event.schema.json",
  "title": "TokenCostAnalyserEvent",
  "description": "A single LLM token-usage event emitted at end-of-agent-run. No PII.",
  "type": "object",
  "required": ["ts", "session_id", "agent_id", "model", "tokens", "trigger"],
  "unevaluatedProperties": false,
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the event"
    },
    "session_id": {
      "type": "string",
      "description": "UUID identifying the agent session"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier for the agent that produced this event"
    },
    "model": {
      "type": "string",
      "description": "Model ID used (e.g. claude-sonnet-4-5)"
    },
    "tokens": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input":       { "type": "integer", "minimum": 0 },
        "output":      { "type": "integer", "minimum": 0 },
        "cache_read":  { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "string",
      "description": "What triggered this event (e.g. end-of-run, manual)"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock duration of the agent run in milliseconds"
    }
  },
  "allOf": [
    { "not": { "required": ["prompt"] } },
    { "not": { "required": ["content"] } },
    { "not": { "required": ["code"] } },
    { "not": { "required": ["pii"] } }
  ]
}
