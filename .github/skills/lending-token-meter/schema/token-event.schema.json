{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "token-event.schema.json",
  "title": "LendingTokenEvent",
  "description": "A single token-usage event emitted by a lending agent skill invocation. No prompt content, no source code, no PII.",
  "type": "object",
  "required": ["ts", "session_id", "agent_id", "model", "tokens", "trigger"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {"required": ["prompt"]}, {"required": ["content"]},
      {"required": ["code"]},   {"required": ["pii"]}
    ]
  },
  "properties": {
    "ts":          {"type": "string", "format": "date-time"},
    "session_id":  {"type": "string"},
    "agent_id":    {"type": "string"},
    "step_id":     {"type": ["integer", "null"]},
    "skill_id":    {"type": ["string", "null"]},
    "model":       {"type": "string"},
    "tokens": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input":       {"type": "integer", "minimum": 0},
        "output":      {"type": "integer", "minimum": 0},
        "cache_read":  {"type": "integer", "minimum": 0, "default": 0},
        "cache_write": {"type": "integer", "minimum": 0, "default": 0}
      }
    },
    "wall_clock_ms": {"type": ["integer", "null"]},
    "repo":          {"type": ["string", "null"]},
    "actor":         {"type": ["string", "null"]},
    "trigger":       {"type": "string", "enum": ["vscode-chat", "actions-workflow", "cli", "unknown"]}
  }
}
