{
  "name": "jira-requirements-agent",
  "version": "1.0.0",
  "description": "Agent that connects to the Jira MCP server and generates requirements documents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:env": "node --env-file ../.env dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:env": "node --env-file ../.env --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
