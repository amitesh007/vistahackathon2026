# Jira MCP Server — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Base URL of your Jira instance (no trailing slash)
JIRA_URL=https://your-domain.atlassian.net

# ── Auth type ────────────────────────────────────────────────────────────────
# "basic"  → Jira Cloud:     email + API token (from id.atlassian.com)
# "bearer" → Jira Server/DC: Personal Access Token (PAT generated in Jira)
JIRA_AUTH_TYPE=bearer

# ── API version ───────────────────────────────────────────────────────────────
# "3" → Jira Cloud (default when JIRA_AUTH_TYPE=basic)
# "2" → Jira Server / Data Center (default when JIRA_AUTH_TYPE=bearer)
JIRA_API_VERSION=2

# Required for JIRA_AUTH_TYPE=basic only
JIRA_EMAIL=your-email@example.com

# API token (Cloud) or Personal Access Token (Server/DC)
JIRA_API_TOKEN=your-token-here

# Optional: override the directory where attachments are downloaded
# Defaults to <cwd>/assets/<TICKET-KEY>/ when not set
# ASSETS_DIR=C:/path/to/your/assets

# ── Optional: GitHub token for AI-powered requirements generation ─────────────
# GITHUB_TOKEN=ghp_your_token_here
